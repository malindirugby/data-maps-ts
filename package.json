{
  "name": "@malindirugby/data-maps-ts",
  "version": "0.0.1",
  "description": "canoncial typescrip data definitions for entities, attributes, relationships, validation and usage policies",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/malindirugby/data-maps-ts.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.t",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import {rmSync} from 'node:fs'; rmSync('dist', {recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "prepack": "npm run build"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^2.1.8"    
  },
  "engines": {
    "node": ">=20"
  }
}
